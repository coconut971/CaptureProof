{
  "Logging": { "LogLevel": { "Default": "Warning", "CaptureProof": "Information", "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning", "Microsoft.AspNetCore.SignalR": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1",
  "CaptureProof": {
    "PublicOrigin": "https://localhost:7443",
    "DevelopmentOrigin": "http://localhost:5080",
    "DataDirectory": ".data/captureproof",
    "RetentionHours": 24,
    "MaxSessionsPerOwner": 10,
    "MaxStoredBytes": 536870912,
    "MaxSessions": 1000,
    "Policies": {
      "vinyl": { "MinPhotos": 1, "MaxPhotos": 3, "MaxBytesPerPhoto": 5242880, "SessionTtlSeconds": 600 }
    }
  }
}
