{
  "name": "@captureproof/receipt-verifier",
  "version": "0.1.0",
  "description": "Vérification indépendante des reçus CaptureProof et de leurs fichiers originaux.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "captureproof-verify": "./dist/cli.js" },
  "files": ["dist", "README.md", "README.fr.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "verify": "node dist/cli.js"
  },
  "dependencies": { "jose": "6.2.13" }
}
